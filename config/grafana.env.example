# Modèle du fichier data_connection/lab_sales_grafana.env (hors du dépôt).
# Copier ce fichier, remplacer les valeurs, ne jamais le committer.

# Mot de passe du compte admin de Grafana (http://localhost:3002)
GF_SECURITY_ADMIN_PASSWORD=a_remplacer

# Mot de passe du rôle PostgreSQL grafana_lecture (lecture seule sur ops)
GRAFANA_LECTURE_PASSWORD=a_remplacer

# Nom de la base des ventes (même valeur que POSTGRES_DB de lab_sales_postgres_ventes.env)
GRAFANA_DB_NAME=a_remplacer
